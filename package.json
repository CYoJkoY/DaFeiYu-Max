{
  "name": "magpie-dafeiyu",
  "type": "module",
  "version": "0.1.6",
  "description": "Magpie page for the DaFeiYu desktop pet (a separate app you download). Request bulbs, quota percentages and API balances for Windows and macOS. Artwork from PC2005-cloud/dsh-pet, non-commercial.",
  "repository": {
    "type": "git",
    "url": "https://github.com/wolfvoid/magpie-DaFeiYu.git"
  },
  "homepage": "https://github.com/wolfvoid/magpie-DaFeiYu#readme",
  "author": "wolfvoid",
  "license": "MIT",
  "keywords": [
    "magpie",
    "macos",
    "windows",
    "desktop-pet",
    "dafeiyu",
    "deepseek",
    "electron",
    "quota-monitor"
  ],
  "files": [
    "magpie",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "magpie": {
    "page": {
      "title": "DaFeiYu",
      "titles": {
        "zh": "蓝色大肥鱼",
        "zh-TW": "藍色大肥魚"
      },
      "file": "magpie/index.html",
      "icon": "magpie/icon.png"
    },
    "permissions": []
  },
  "scripts": {
    "prepare": "node scripts/prepare.ts",
    "build": "node scripts/build.ts",
    "icons": "node scripts/icons.ts",
    "typecheck": "tsc --noEmit",
    "start": "electron dist/main.cjs",
    "test": "node --test tests/*.test.ts",
    "check": "node scripts/check.ts",
    "package": "node scripts/package.ts",
    "assets": "node scripts/download-assets.ts",
    "verify:build": "node scripts/verify-build.ts",
    "verify:archives": "node scripts/verify-archives.ts",
    "capture:pet": "electron dist/tools/capture-demo.cjs",
    "capture:panel": "electron dist/tools/capture-panel-demo.cjs",
    "prepack": "node scripts/build.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^26.6.6",
    "electron": "43.3.0",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "typescript": "^7.0.2"
  }
}
